# Target GitHub Organization
VITE_GITHUB_ORG=Move2Move

# Server-Side GitHub Personal Access Token (Never exposed to client bundles)
# - On Vercel: Set GITHUB_TOKEN in Project Settings > Environment Variables (NO VITE_ prefix).
# - In local development: Put GITHUB_TOKEN in your local .env for the local dev proxy.
# Recommended token scopes:
# - Fine-grained PAT: Read-only access to 'Metadata' and 'Contents'
# - Classic PAT: 'repo' (for private repos), 'read:org'
GITHUB_TOKEN=ghp_your_classic_personal_access_token_here
